{
  // Configurazione per pubblicare GymTrack su Cloudflare in modalità autonoma.
  // Guida completa: docs/CLOUDFLARE_DEPLOY.md
  "name": "gymtrack",
  "main": "dist/cloudflare/index.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "dist/gymtrack/browser",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gymtrack-accounts",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "gymtrack-archives"
    }
  ],
  "vars": {
    "SELF_HOSTED": "1",
    // Indirizzo pubblico (non segreto) del servizio calendario/notifiche: vedi calendar-relay/README.md
    "CALENDAR_RELAY_URL": "https://gymtrack-calendar.tandu-gymtrack.workers.dev"
  },
  // Controllo giornaliero dello spazio R2 (alle 06:00 UTC) e, ogni 30 minuti, i dati dell'auto
  // dal portale Volkswagen (solo con i segreti VW_ID_EMAIL e VW_ID_PASSWORD): vedi docs/CLOUDFLARE_DEPLOY.md
  "triggers": {
    "crons": ["0 6 * * *", "*/30 * * * *"]
  },
  "observability": {
    "enabled": false
  }
}
