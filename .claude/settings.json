{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./docs/qa/**)",
      "Read(./public/vendor/**)",
      "Read(./public/training/vendor/**)",
      "Read(./public/training/figures/**)",
      "Read(./public/training/motion/**)",
      "Read(./drizzle/meta/**)",
      "Read(./package-lock.json)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./.angular/**)",
      "Read(./.cache/**)",
      "Read(./.dev.vars)",
      "Read(./**/.env*)",
      "Read(./src/app/services/exercise-artwork-catalog.json)",
      "Read(./worker/default-catalog.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/prettier-dopo-modifica.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
