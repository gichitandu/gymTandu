{
  "name": "gymtrack-calendar",
  "main": "index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gymtrack-calendar",
      "database_id": "REPLACE_WITH_CREATED_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "PUSH_SCHEDULER_ENABLED": "true",
    "PUSH_VAPID_SUBJECT": "mailto:giacomotanduo004@gmail.com"
  }
}
