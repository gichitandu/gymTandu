{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/*.html",
          "/*.css",
          "/*.js",
          "/*.webmanifest",
          "/icons/**",
          "/apple-touch-icon*.png",
          "/favicon.ico",
          "/templates/**",
          "/*.webp",
          "/brand/**",
          "/exercises/**",
          "/training/figures/**",
          "/training/dumbbell.png"
        ]
      }
    },
    {
      "name": "local-ai-runtime",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/vendor/*.js",
          "/vendor/food-model/**"
        ]
      }
    },
    {
      "name": "training-visuals",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/training/**",
          "!/training/videos/**"
        ]
      }
    }
  ]
}
