{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/*.html",
          "/*.css",
          "/*.js",
          "/*.webmanifest",
          "/icons/**",
          "/*.webp"
        ]
      }
    },
    {
      "name": "local-ai-runtime",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/vendor/*.js"
        ]
      }
    }
  ]
}
