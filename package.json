{
  "name": "gymtrack",
  "version": "1.0.0",
  "description": "Diario personale di allenamento Angular, offline e gratuito",
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "test": "vitest run",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "check": "ng build --configuration development",
    "preview": "node tools/serve.mjs",
    "build:sandbox": "node --require ./tools/sandbox-compat.cjs ./node_modules/@angular/cli/bin/ng.js build",
    "format": "prettier --write src tests tools *.json *.md .github/workflows/*.yml",
    "format:check": "prettier --check src tests tools *.json *.md .github/workflows/*.yml",
    "format:setup": "prettier --check AGENTS.md README.md AUTHENTICATION.md package.json package-lock.json docs/CODEX_*.md .github/workflows/*.yml",
    "verify:build": "node tools/verify-build.mjs",
    "test:package": "node tests/runtime/design-studio-package-check.mjs && node tests/runtime/packaged-training-upgrades.mjs && node tests/runtime/packaged-assets.mjs",
    "quality": "npm run typecheck && npm test && npm run build && npm run verify:build && npm run test:package",
    "postbuild": "node tools/package-worker.mjs",
    "package:deploy": "node tools/package-deploy.mjs",
    "db:generate": "drizzle-kit generate",
    "test:affected": "node tools/test-affected.mjs"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "chart.js": "^4.6.1",
    "dexie": "^4.4.6",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "fake-indexeddb": "^6.2.7",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true
}
