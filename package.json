{
  "name": "gymtrack",
  "version": "1.0.0",
  "description": "Diario personale di allenamento Angular, offline e gratuito",
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "test": "vitest run",
    "check": "ng build --configuration development",
    "preview": "node tools/serve.mjs",
    "build:sandbox": "node --require ./tools/sandbox-compat.cjs ./node_modules/@angular/cli/bin/ng.js build",
    "format": "prettier --write src tests tools *.json *.md .github/workflows/*.yml",
    "verify:build": "node tools/verify-build.mjs",
    "postbuild": "node tools/package-worker.mjs",
    "package:deploy": "node tools/package-deploy.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "chart.js": "^4.5.1",
    "dexie": "^4.4.6",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "private": true
}
